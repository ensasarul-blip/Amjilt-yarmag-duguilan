# ---------------------------------------------------------------
# Supabase төслийн тохиргоо
# Supabase дээр: Project Settings -> Data API / API Keys хэсгээс хуулна
#
# ⚠️ ЭНЭ ФАЙЛ GitHub ДЭЭР НЭЭЛТТЭЙ ХАРАГДАНА.
#    Жинхэнэ түлхүүрээ ЭНД БҮҮ БИЧ — зөвхөн `.env.local` дотор бич.
# ---------------------------------------------------------------

# Төслийн хаяг. Жишээ: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ТӨСЛИЙН-ХАЯГ.supabase.co

# Нийтийн түлхүүр: "sb_publishable_..." (хуучин төсөлд "anon / public")
# ⚠️ "sb_secret_..." эсвэл "service_role" түлхүүрийг ЭНД БҮҮ БИЧ — тэр нь тун нууц!
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ТАНЫ_НИЙТИЙН_ТҮЛХҮҮР

# ---------------------------------------------------------------
# Зөвхөн ТЕСТ ажиллуулахад хэрэгтэй (заавал биш).
# Хоосон орхивол тест локал дээрээ түр PostgreSQL асааж шалгана.
# Supabase -> Project Settings -> Database -> Connection string (URI)
# ---------------------------------------------------------------
# DATABASE_URL=
